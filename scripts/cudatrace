#!/usr/bin/env bash
# Run any CUDA program under cudatrace.
#   cudatrace [-o trace.json] [--driver] -- <program> [args...]
set -euo pipefail

usage() {
  echo "usage: cudatrace [-o OUTPUT] [--driver] [--quiet] [--] PROGRAM [ARGS...]" >&2
  exit 2
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lib="${CUDATRACE_LIB:-}"
if [[ -z "$lib" ]]; then
  for candidate in "$script_dir/../lib/libcudatrace.so" "$script_dir/../build/libcudatrace.so"; do
    if [[ -f "$candidate" ]]; then lib="$(cd "$(dirname "$candidate")" && pwd)/libcudatrace.so"; break; fi
  done
fi
[[ -n "$lib" ]] || { echo "cudatrace: libcudatrace.so not found; build it or set CUDATRACE_LIB" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output) [[ $# -ge 2 ]] || usage; export CUDATRACE_OUTPUT="$2"; shift 2 ;;
    --driver) export CUDATRACE_DRIVER=1; shift ;;
    --quiet) export CUDATRACE_QUIET=1; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[[ $# -gt 0 ]] || usage

export CUDA_INJECTION64_PATH="$lib"
exec "$@"
